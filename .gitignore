# sphinx build directories
_build/

# dotfiles
.*
!.gitignore
!.gitkeep
!.github
!.mailmap
!.weblate.json
# Claude Code config: the guardrails have to travel with the repo. Without
# these exceptions the blanket ".*" above keeps .claude/ and .mcp.json out of
# git, and the whole layer would exist only on this machine.
!.claude/
!.mcp.json
# ...except the per-machine overrides, which stay local.
.claude/settings.local.json
# compiled python files
*.py[co]
__pycache__/
# setup.py egg_info
*.egg-info
# emacs backup files
*~
# hg stuff
*.orig
status
# odoo filestore
odoo/filestore
# maintenance migration scripts
odoo/addons/base/maintenance
# windows installation config file
/odoo.conf

# generated for windows installer?
install/win32/*.bat
install/win32/meta.py

# needed only when building for win32
setup/win32/static/less/
setup/win32/static/wkhtmltopdf/
setup/win32/static/postgresql*.exe

# js tooling
node_modules
jsconfig.json
tsconfig.json
package-lock.json
package.json
.husky

# various virtualenv
/bin/
/build/
/dist/
/include/
/lib/
/man/
/share/
/src/

# local dev: dumps y filestore de produccion. Datos reales de clientes y este
# repo es publico, asi que nunca deben commitearse.
/odoo-prod-db.sql.gz
/odoo-prod-filestore.tar.gz
/from_server/
/filestore-odoo/
