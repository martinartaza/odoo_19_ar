#. module: artaza_magento_connect
#: model_terms:ir.ui.view,arch_db:artaza_magento_connect.res_config_settings_view_form
msgid ""
"<b>Immediate-payment</b> methods (Magento: <code>processing</code>):\n"
"                                                their orders come in as a <b>confirmed sale</b>, with no price change.\n"
"                                                Enter the <b>codes</b> separated by commas."
msgstr ""

#. module: artaza_magento_connect
#: model_terms:ir.ui.view,arch_db:artaza_magento_connect.res_config_settings_view_form
msgid ""
"<b>Import from</b>: only orders updated at or after this\n"
"                                                moment are brought in. It advances on its own as orders\n"
"                                                arrive. Move it <b>back</b> to re-read a period — orders\n"
"                                                already in Odoo are skipped, never duplicated — or\n"
"                                                <b>forward</b> to ignore the store's history when\n"
"                                                connecting for the first time."
msgstr ""

#. module: artaza_magento_connect
#: model_terms:ir.ui.view,arch_db:artaza_magento_connect.res_config_settings_view_form
msgid ""
"<b>Import from</b>: the same watermark as orders, for\n"
"                                                returns. Move it back to re-read a period without\n"
"                                                duplicating anything."
msgstr ""

#. module: artaza_magento_connect
#: model_terms:ir.ui.view,arch_db:artaza_magento_connect.res_config_settings_view_form
msgid ""
"<b>Payment-pending</b> methods (Magento: <code>new</code> / status\n"
"                                                <code>pending</code>): their orders come in as a <b>quotation</b> to\n"
"                                                negotiate; you can adjust the price and inform Magento. Codes separated by commas."
msgstr ""

#. module: artaza_magento_connect
#: model_terms:ir.ui.view,arch_db:artaza_magento_connect.res_config_settings_view_form
msgid ""
"<b>Shipping tax</b>: the tax put on the shipping line of\n"
"                                                imported orders. Pick the <b>tax-included</b> sale tax your\n"
"                                                accountant uses for freight. The freight's rate is a fiscal\n"
"                                                decision, <b>not</b> the product's. Empty = mirror the\n"
"                                                product's tax."
msgstr ""

