#. module: artaza_magento_connect
#: model_terms:ir.ui.view,arch_db:artaza_magento_connect.res_config_settings_view_form
msgid ""
"⚠️ <b>Tax-included price</b> must be ticked on every mapped tax:\n"
"                                        Magento sends gross prices "
"(<i>Catalog Prices = Including Tax</i>).\n"
"                                        If it is off, imported orders add "
"the tax <b>on top</b> and their\n"
"                                        total stops matching Magento's."
msgstr ""
"⚠️ <b>Precio con impuesto incluido</b> debe estar marcado en todos los "
"impuestos relacionados: Magento envía precios brutos (<i>Catalog Prices = "
"Including Tax</i>). Si está desmarcado, los pedidos importados suman el "
"impuesto <b>por encima</b> y su total deja de coincidir con el de Magento."

