{
  "permissions": {
    "allow": [
      "Edit(./custom_addons/artaza_magento_connect/**)",
      "Write(./custom_addons/artaza_magento_connect/**)",
      "Bash(./.claude/skills/run-module-tests/run-tests.sh:*)",
      "mcp__trello__get_card",
      "mcp__trello__list_cards",
      "mcp__trello__list_board_lists",
      "mcp__trello__set_card_description",
      "mcp__trello__move_card",
      "mcp__trello__add_comment"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/clave.txt)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat .env:*)",
      "Bash(cat ../clave.txt:*)",
      "Bash(dropdb:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker compose down -v:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Edit(./addons/**)",
      "Write(./addons/**)",
      "Edit(./odoo/**)",
      "Write(./odoo/**)",
      "Read(./odoo-prod-*)",
      "Read(./from_server/**)",
      "Read(./filestore-odoo/**)",
      "Bash(zcat:*)",
      "Bash(zgrep:*)",
      "Bash(zless:*)",
      "Bash(gunzip:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_dumpall:*)",
      "Bash(pg_restore:*)",
      "Bash(mysqldump:*)",
      "Bash(printenv:*)",
      "Bash(docker compose config:*)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-filter.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__trello__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-check.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
